post_install() {
    echo ">>> JPGS: встроенного ключа шифрования нет."
    echo ">>> Задайте свой ключ командой  jpgs set-key  (или программа спросит его при первом запуске)."
    echo ">>> Если у вас уже есть зашифрованные файлы — введите тот же ключ, которым они созданы."
}

post_upgrade() {
    post_install
}
